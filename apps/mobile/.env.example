# CLOUD6 mobile environment variables
# Copy to apps/mobile/.env and adjust locally. Expo only exposes vars
# prefixed EXPO_PUBLIC_ to the client bundle — never put secrets here.

# Set to "mock" to use mockDeviceLocationProvider instead of real device
# GPS — useful when a simulator/dev environment can't provide location.
# Leave unset (or anything other than "mock") for real GPS. Development
# only; never set this in a production build.
EXPO_PUBLIC_LOCATION_PROVIDER=

# Base URL of the CLOUD6 backend (apps/server; defaults to port 3000 —
# see apps/server/.env PORT). The mobile app never calls Open-Meteo or
# OSRM directly — it always goes through this backend.
#
# - iOS Simulator / Android Emulator / Web: http://localhost:3000 works.
# - Physical phone via Expo Go: localhost is the PHONE, not your Mac.
#   Use your Mac's LAN IP instead, e.g. http://192.168.1.23:3000
#   (find yours with `ipconfig getifaddr en0` on macOS). Phone and Mac
#   must be on the same Wi-Fi network.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
