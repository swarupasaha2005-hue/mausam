# CLOUD6 backend environment variables.
# Copy to apps/server/.env and adjust locally — dotenv loads .env from
# this directory (apps/server), not the repo root.
#
# Nothing here is a secret: Open-Meteo and OSRM's demo server are free,
# keyless public APIs. All values below are optional — the server runs
# with these exact defaults if the file is absent.

PORT=3000
NODE_ENV=development

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
WEATHER_REQUEST_TIMEOUT_MS=8000

OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_REQUEST_TIMEOUT_MS=8000
