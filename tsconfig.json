{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@cloud6/shared": ["packages/shared/src"],
      "@cloud6/shared/*": ["packages/shared/src/*"]
    }
  },
  "exclude": ["node_modules", "**/node_modules", "**/dist", "**/.expo"]
}
