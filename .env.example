# CLOUD6 backend environment variables
# Copy to .env and fill in real values locally. Never commit real secrets.

PORT=3000
NODE_ENV=development

# External provider keys — providers are intentionally undecided in Phase 1.
# The integrations/ layer in apps/server abstracts these so a provider
# can be swapped later without touching business logic.
WEATHER_API_KEY=
MAPS_API_KEY=
AI_API_KEY=
