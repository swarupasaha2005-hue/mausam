{
  "name": "cloud6",
  "private": true,
  "version": "0.1.0",
  "description": "CLOUD6 — personalized weather decision-support app (SIH26076: Personalized homepage for 'Mausam')",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @cloud6/server",
    "mobile": "npm run start --workspace @cloud6/mobile",
    "server": "npm run dev --workspace @cloud6/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint apps/server/src apps/mobile/app apps/mobile/src packages/shared/src --ext .ts,.tsx",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "react": "19.2.3"
  }
}
